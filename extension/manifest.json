{
  "manifest_version": 3,
  "name": "Lock In",
  "version": "0.3.0",
  "description": "Connects your browser to the Lock In desktop coach: reports the active tab, shows the coach's card over distractions, and can pause, close or block them.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms", "scripting", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lock In",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
